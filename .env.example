PORT=3000
APP_URL=http://localhost:5173
DATABASE_PATH=./data/cerca.sqlite
DEMO_MODE=true
REGISTRATION_OPEN=true
# In production, set a unique secret of at least 32 characters. Never commit it.
# APP_ENCRYPTION_KEY=
# Optional: OpenAI classifies ambiguous store questions. Replies always use stored facts.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
META_GRAPH_VERSION=v23.0
# Set to 1 only behind a trusted reverse proxy (Render, for example).
TRUST_PROXY=0
